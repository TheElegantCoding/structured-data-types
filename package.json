{
  "name": "structured-data-types",
  "description": "📦️ Ultra-lightweight, strict TypeScript definitions for Google Rich Results and Schema.org structured data. Built for performance-focused web development.",
  "author": "Luis Monsalve",
  "version": "1.0.0",
  "homepage": "https://github.com/TheElegantCoding/structured-data-types#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheElegantCoding/structured-data-types.git"
  },
  "keywords": [
    "typescript",
    "structured-data",
    "json-ld",
    "schema-org",
    "structured-data",
    "google-rich-results",
    "metadata",
    "seo",
    "types"
  ],
  "bugs": {
    "url": "https://github.com/TheElegantCoding/structured-data-types/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["./dist"],
  "engines": {
    "node": ">=22.17.0",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "postinstall": "bunx gitlys init",
    "release": "bunx gitlys release",
    "prepublishOnly": "bun run build",
    "lint": "eslint . --fix ",
    "build": "tsup"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "eslint-config-universal-code": "^1.0.13",
    "gitlys": "^1.1.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
